# ---- Dashboard ----
DASHBOARD_PASSWORD=choose-a-strong-password
WEBHOOK_SECRET=any-long-random-string
INGEST_SECRET=another-long-random-string

# ---- Google Places (used ONLY to find phone numbers) ----
GOOGLE_PLACES_API_KEY=

# ---- Voice provider (Rasen outbound) ----
VOICE_PROVIDER=rasen
RASEN_WORKSPACE_KEY=
RASEN_AGENT_ID=
RASEN_PHONE_NUMBER_ID=
# RASEN_API_BASE=https://kalpa-api-454269687527.asia-south1.run.app/api/rasen/workspace
# Webhook URL in Rasen dashboard:
# https://YOUR-APP.vercel.app/api/webhook?key=WEBHOOK_SECRET

# ---- Optional: Vapi instead of Rasen ----
# VOICE_PROVIDER=vapi
# VAPI_API_KEY=
# VAPI_ASSISTANT_ID=
# VAPI_PHONE_NUMBER_ID=

# ---- Hot / warm / cold grading (free) ----
# Free key: aistudio.google.com > Get API key. Leave empty to use simple keyword grading.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Optional paid alternative:
# ANTHROPIC_API_KEY=

# ---- Optional: makes the "Fetch leads now" button work ----
# GH_REPO=your-github-username/your-repo-name
# GH_TOKEN=github fine-grained token with Actions: read and write on that repo
# GH_BRANCH=main

# ---- Optional ----
# DEFAULT_COUNTRY_CODE=+91
# PLACES_REGION=IN
# CALL_WINDOW=10-19
# CALL_TZ=Asia/Kolkata
